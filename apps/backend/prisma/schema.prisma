// MTG Companion — Prisma schema
// Design notes live in backend/README.md. Summary of the shape:
//   User 1—1 UserSettings, User 1—N Card (owner), User N—N User via Transaction
//   (buyer/seller), Card 1—N CardPhoto.

// Using the classic "prisma-client-js" generator (CommonJS output, well-worn
// with Nest's default CJS build) rather than Prisma 7's newer "prisma-client"
// generator, which emits ESM-only code (`import.meta.url`) and breaks Nest's
// default CommonJS compilation.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  displayName     String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  settings      UserSettings?
  cards         Card[]         @relation("CardOwner")
  purchases     Transaction[]  @relation("BuyerTransactions")
  sales         Transaction[]  @relation("SellerTransactions")
  refreshTokens RefreshToken[]
  offers        Offer[]
  decks         Deck[]
  coupons       Coupon[]

  @@map("users")
}

// One row per user. Created together with the User at registration time.
model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  language String @default("en") // matches src/i18n.ts locales: en / es-LA / fr
  theme    String @default("dark")

  // 2FA fields are modeled now (target: TOTP) but the enrollment/verification
  // flow itself is not implemented yet — see backend/README.md "What's next".
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // TOTP secret, set once enrollment ships; never returned by any endpoint

  notifyByEmail Boolean @default(true)

  // Bazaar "how far are they" distance (see TabSearch.tsx / F6-E6 in
  // ROADMAP.md). Calling PATCH /users/me/location *is* the consent — there's
  // no separate on/off toggle in the UI, same as a dating-app-style
  // location prompt. lastLat/lastLng are null (shareLocation false) until
  // the user grants browser geolocation and it round-trips once.
  shareLocation     Boolean   @default(false)
  lastLat           Float?
  lastLng           Float?
  locationUpdatedAt DateTime?

  @@map("user_settings")
}

// One row per issued refresh token (POST /auth/refresh — see AuthService).
// Stores a hash, never the raw token — same principle as User.passwordHash,
// just SHA-256 instead of bcrypt: this is a high-entropy random token, not a
// low-entropy user secret, so bcrypt's deliberate slowness buys nothing.
// Rotated on every use: AuthService.refresh() deletes the row for the
// presented token and inserts a new one for the token it returns, so
// replaying an already-used refresh token (e.g. one stolen off a device
// that has since refreshed) is rejected outright instead of silently
// working.
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Cards
// ─────────────────────────────────────────────────────────────────────────

enum CardCondition {
  NM // Near Mint
  LP // Lightly Played
  MP // Moderately Played
  HP // Heavily Played
  DMG // Damaged

  @@map("card_condition")
}

// VAULT = a permanent collection entry (today's only behavior). SCAN_LISTING =
// created purely to generate a sell QR from Smart Scan (ROADMAP.md J1) — a
// row still needs to exist for Transaction's FK, but Tab3.tsx's Vault view
// filters these out. Default VAULT keeps every existing row's behavior
// unchanged.
enum CardOrigin {
  VAULT
  SCAN_LISTING

  @@map("card_origin")
}

model Card {
  id      String @id @default(uuid())
  ownerId String
  owner   User   @relation("CardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title        String
  description  String?
  guessedPrice Decimal       @db.Decimal(10, 2)
  condition    CardCondition @default(NM)
  origin       CardOrigin    @default(VAULT)

  // Optional, filled in once a card is matched against the Scryfall-derived
  // catalog (Certamen 1/2 Stage 1 retrieval). Kept nullable/free-form here on
  // purpose: the catalog itself is not duplicated into this DB, this is just
  // enough to render CardDetails.tsx without a second lookup.
  scryfallId String?
  setName    String?
  rarity     String?
  oracleText String?

  // Auction state (ROADMAP.md J12) — every Offer extends closesAt to
  // now+5s; OffersService.getAuctionState() lazily resolves once
  // now > closesAt (no cron job), clearing closesAt and pointing
  // wonOfferId at the latest Offer for this card. TransactionsService
  // .create() consumes wonOfferId (as the amount source) and clears it
  // back to null so a later re-auction of the same card starts clean. Both
  // null = "not currently up for bidding," the same as every Card today.
  closesAt   DateTime?
  wonOfferId String?

  // ROADMAP.md K — organizing a Vault into named decks/folders. One deck
  // per card (K1's resolved design decision: matches the physical-binder
  // mental model this app already uses, same reasoning as Card.origin's
  // "physical card changing hands" framing — not a many-to-many
  // deckbuilding-list model). Nullable = "Unsorted", the default and the
  // only state every existing row had before this field existed.
  // `onDelete: SetNull` is deliberate, not an oversight: deleting a deck
  // un-assigns its cards back to Unsorted at the DB level, guaranteed
  // regardless of which code path deletes the Deck row, rather than a
  // cascade that would delete the cards themselves — a deck is an
  // organizational label on a card the user owns, not a container that
  // owns the card.
  deckId String?
  deck   Deck?   @relation(fields: [deckId], references: [id], onDelete: SetNull)

  photos       CardPhoto[]
  transactions Transaction[]
  offers       Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([deckId])
  @@map("cards")
}

// ROADMAP.md K2 — a named grouping of a user's own cards (e.g. "Modern
// deck", "Commander binder", "Bulk"). Deliberately no card-count/value
// aggregate stored here (K6, not built) — Tab3.tsx/DecksController compute
// that on read from the real Card rows, same "don't cache what's cheap to
// recompute and easy to let drift" posture as everywhere else in this schema.
model Deck {
  id      String @id @default(uuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name String

  cards Card[]

  createdAt DateTime @default(now())

  @@index([ownerId])
  @@map("decks")
}

// One row per bid in a card's live auction (ROADMAP.md J12). Never updated
// or deleted — the "current" offer is always just the latest row for a
// given cardId, found by createdAt, not a separate mutable pointer.
model Offer {
  id     String @id @default(uuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  bidderId String
  bidder   User   @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
  @@map("offers")
}

model CardPhoto {
  id     String @id @default(uuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // Object key inside the storage bucket (see storage module) — not a public
  // URL. The API resolves a URL (signed or public, depending on bucket
  // policy) at read time instead of freezing one into the DB.
  storageKey String
  isPrimary  Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([cardId])
  @@map("card_photos")
}

// ─────────────────────────────────────────────────────────────────────────
// Catalog (F6 — read-only Scryfall metadata, imported in bulk by
// `prisma/import-catalog.ts` from certamen_1/data/cards.json, NOT the same
// thing as Card above. Card is a physical card a user owns/lists; this is
// the full ~58k-row reference catalog the Bazaar search (E6) matches
// against so it can suggest real card names even for cards nobody has
// listed yet. Never written to by the app itself, only by the import
// script — no relation to Card on purpose, same "don't duplicate the
// catalog into owned rows" reasoning already documented on Card above.
// ─────────────────────────────────────────────────────────────────────────

model CatalogCard {
  // Scryfall's own per-printing UUID (`cards.json`'s "id") — one row per
  // printing, not per card name, matching how the ML pipeline's own
  // catalog/embedding-index is keyed.
  id String @id

  name       String
  setCode    String
  setName    String
  rarity     String?
  typeLine   String?
  manaCost   String?
  cmc        Float?
  colors     String[]
  oracleText String?  @db.Text
  imageUrl   String?
  edhrecRank Int?

  // Added for ROADMAP.md E3b — Stage 3's client-side tabular feature
  // builder (priceFeatures.ts, mirrors pytorch/src/price_features.py) needs
  // these to build its 50-dim vector for a catalog-identified card at scan
  // time; the fields above alone aren't enough (no set_type/frame/
  // border_color/color_identity/finishes/frame_effects/released_at).
  setType       String?
  frame         String?
  borderColor   String?
  colorIdentity String[]
  finishes      String[]
  frameEffects  String[]
  releasedAt    String?

  createdAt DateTime @default(now())

  @@index([name])
  @@map("catalog_cards")
}

// ─────────────────────────────────────────────────────────────────────────
// Transactions
// ─────────────────────────────────────────────────────────────────────────

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
  FAILED

  @@map("transaction_status")
}

// MERCADOPAGO = real Checkout Pro redirect, settles async via webhook.
// CASH = in-person "Efectivo" — settles synchronously at creation time
// (see CashPaymentProvider), also the fast no-credentials path for
// testing/demos.
enum PaymentMethod {
  MERCADOPAGO
  CASH

  @@map("payment_method")
}

model Transaction {
  id String @id @default(uuid())

  cardId String
  card   Card   @relation(fields: [cardId], references: [id])

  buyerId String
  buyer   User   @relation("BuyerTransactions", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerTransactions", fields: [sellerId], references: [id])

  amount        Decimal           @db.Decimal(10, 2)
  status        TransactionStatus @default(PENDING)
  paymentMethod PaymentMethod     @default(MERCADOPAGO)

  // Populated once a payment provider actually runs (see payments module).
  // paymentRef is unique — the MercadoPago webhook looks a transaction up
  // by it, so two transactions colliding on the same ref would misroute a
  // payment confirmation.
  paymentProvider String?
  paymentRef      String? @unique

  // Nullable, no FK owned here — the FK (and its @@unique) lives on Coupon
  // (ROADMAP.md L2/L3), same "FK on the many/optional side" shape as every
  // other relation in this file. A transaction can redeem at most one
  // coupon (L1's design decision: single-use, not stackable).
  coupon Coupon?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([cardId])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────────────────
// Spin-the-wheel coupons (ROADMAP.md L). Design decisions resolved with the
// user (L1, 19 ago): daily spin (one per user per 24h, enforced by the L3
// spin endpoint reading the latest Coupon.createdAt for that user — no
// separate "last spin" timestamp needed, this table already records every
// spin), % off the card's price capped at a flat $ amount (never an
// uncapped % or a flat $ alone), 3 weighted prize tiers (5%/$5, 10%/$10,
// 20%/$25), single-use (never stackable — enforced by Transaction's 1-1
// optional relation above, not just application logic), expires 7 days
// after being won. Redemption is baked into Transaction.amount at purchase
// time (L3), not a separate pre-checkout price adjustment — so this model
// deliberately has no relation to Card.
// ─────────────────────────────────────────────────────────────────────────

model Coupon {
  id String @id @default(uuid())

  issuedToUserId String
  issuedToUser   User   @relation(fields: [issuedToUserId], references: [id], onDelete: Cascade)

  // The wheel's prize tier at issuance time (L1: 5/10/20), stored as plain
  // numbers rather than an enum — L3's redemption math is just
  // `min(card.guessedPrice * discountPercent / 100, maxDiscount)`, no
  // lookup table needed at redemption time, and a future tier
  // rebalance never has to touch coupons already issued under the old one.
  discountPercent Int
  maxDiscount     Decimal @db.Decimal(10, 2)

  // Both null = unredeemed. Set together, in the same L3 transaction, the
  // moment a purchase actually applies this coupon — never independently,
  // so a coupon can't end up "redeemed" without a Transaction to point at
  // or vice versa.
  redeemedAt              DateTime?
  redeemedInTransactionId String?      @unique
  redeemedInTransaction   Transaction? @relation(fields: [redeemedInTransactionId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([issuedToUserId])
  @@map("coupons")
}
