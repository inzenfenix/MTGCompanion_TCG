<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Live camera preview (Tab2/ListCard/GuidedCapture's Smart Scan —
         `navigator.mediaDevices.getUserMedia({video:..., audio:false})` in
         useLiveCamera.ts). Capacitor's BridgeWebChromeClient already
         implements onPermissionRequest()'s runtime-permission-request flow
         out of the box (no app code needed) — but Android silently denies
         any runtime permission the manifest never declares, so the OS
         prompt never appeared without this. audio:false in the actual
         getUserMedia call — no RECORD_AUDIO/MODIFY_AUDIO_SETTINGS needed. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Bazaar tab's "like Tinder" distance search (TabSearch.tsx,
         navigator.geolocation.getCurrentPosition — see PATCH
         /users/me/location, ROADMAP.md E6). Coarse is enough for a
         city-scale distance estimate, but both are requested together
         (same as BridgeWebChromeClient's onGeolocationPermissionsShowPrompt
         default) so the OS can grant "approximate" if the user declines
         "precise". -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
