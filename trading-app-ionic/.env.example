# Copy this file to .env (gitignored at the repo root) and adjust if needed.
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL of the backend API (backend/ — NestJS, see its own README for how
# to run it). Defaults to http://localhost:3000 if unset, which matches the
# backend's default PORT in backend/.env.example.
VITE_API_BASE_URL=http://localhost:3000

# Where to load the Stage 1 (MTG / no-MTG detector) ONNX model from, used by
# src/lib/ml/stage1Detector.ts on the "Scan & Appraise" tab. No trained model
# ships in this repo yet — see trading-app-ionic/README.md "Pipeline de ML
# del lado del cliente" for how to plug one in once Certamen 1/2's export
# script has been run. Defaults to /models/stage1-detector.onnx (i.e. a file
# at trading-app-ionic/public/models/stage1-detector.onnx) if unset.
# VITE_STAGE1_MODEL_URL=/models/stage1-detector.onnx
