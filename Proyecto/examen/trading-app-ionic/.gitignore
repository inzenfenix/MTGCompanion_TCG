# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/dist

# modelos ONNX generados por Proyecto/certamen_1/{pytorch,tensorFlow}/*export_onnx*.py
# (binarios, se regeneran corriendo el export — no se versionan, mismo criterio
# que pytorch/models/ y tensorFlow/models/ en certamen_1)
/public/models/*.onnx
# escalador de Stage 3, generado por certamen_2/prepare_price_dataset.py sobre
# el catálogo completo (ROADMAP.md E2) — mismo criterio que los .onnx de arriba.
/public/models/stage3-tabular-scaler.json

# tesseract.js (ROADMAP.md E3) descarga el paquete de idioma inglés (~5MB) al
# cwd cuando corre en Node (dev/test/scripts) — el navegador lo trae de su
# propio CDN/cache, esto solo aparece localmente. Mismo criterio que
# certamen_2/.tessdata (gitignored ahí también).
/eng.traineddata

# ROADMAP.md E3c — assets copiados/descargados por
# `npm run setup:tesseract` (scripts/setup-tesseract-assets.mjs) para que
# tesseract.js no dependa de su CDN por defecto: worker.min.js + el motor
# WASM vienen de node_modules (regenerable con un `npm install`), el
# .traineddata en inglés se descarga una vez de jsdelivr. Mismo criterio que
# /public/models/*.onnx arriba — generado, no fuente, no se versiona.
/public/tesseract/
/public/tessdata/

# ROADMAP.md I15 — `npm run setup:opencv` (scripts/setup-opencv-assets.mjs)
# copies @techstark/opencv-js's dist/opencv.js here so it can be loaded as a
# classic <script> tag (cardLocalizer.ts::getOpenCv()) instead of a bundled
# ES/CJS import — same generated-not-source criterion as the tesseract/onnx
# entries above.
/public/opencv.js

# misc
.DS_Store
# ROADMAP.md workstream I: VITE_API_BASE_URL (the real EC2 backend URL,
# post `terraform apply`) gets pasted into a plain .env here — was only
# excluding the .env.*.local variants before, not bare .env itself.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
/.nx
/.nx/cache
/.vscode/*
!/.vscode/extensions.json
.idea

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional eslint cache
.eslintcache
