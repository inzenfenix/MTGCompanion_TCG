<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (API 28+) blocks plaintext HTTP by default. ROADMAP.md
  workstream I's backend runs on a bare EC2 IP over plain HTTP (no domain/
  TLS in the v1 infra plan — see Proyecto/examen/infra/terraform/README.md
  "TLS / domain") — this is a dev/course-project-only cleartext exception,
  NOT a production-appropriate answer. Replace REPLACE_WITH_BACKEND_HOST
  below with the real host from `terraform output backend_public_ip` (or
  backend_public_dns) after `terraform apply`, then rebuild
  (npm run build -> npx cap sync android -> gradlew assembleDebug).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">52.2.195.2</domain>
    </domain-config>
</network-security-config>
