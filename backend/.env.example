# Copy this file to .env and adjust as needed. .env is gitignored.
# This same file feeds both the NestJS app (via @nestjs/config) and
# docker-compose (via docker/dev.sh, which passes --env-file .env).

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (Postgres — started via docker/dev.sh up) ─────────────────────
POSTGRES_USER=mtg
POSTGRES_PASSWORD=mtg
POSTGRES_DB=mtg_companion
POSTGRES_PORT=5432
DATABASE_URL="postgresql://mtg:mtg@localhost:5432/mtg_companion?schema=public"

# ── Object storage ──────────────────────────────────────────────────────
# Local dev: MinIO, started via docker/dev.sh up (S3-compatible).
# Prod (EC2): point these at real AWS S3 — same client code, no code change,
# just drop STORAGE_ENDPOINT/STORAGE_FORCE_PATH_STYLE and use real AWS creds.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mtg-card-photos
STORAGE_ACCESS_KEY_ID=mtg_minio_admin
STORAGE_SECRET_ACCESS_KEY=mtg_minio_secret
MINIO_ROOT_USER=mtg_minio_admin
MINIO_ROOT_PASSWORD=mtg_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Email ────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=smtp uses MailHog (docker/dev.sh up) — nothing leaves your
# machine, read "sent" mail at http://localhost:8025. This is the default
# and what the presentation should use.
# EMAIL_PROVIDER=ses switches to AWS SES — needs real AWS_* creds below.
# Skip this on an AWS Academy lab account: those hand out temporary,
# permission-locked credentials with no SES send access, so it likely
# won't work there regardless of what you put below.
EMAIL_PROVIDER=smtp
EMAIL_FROM="MTG Companion <no-reply@mtgcompanion.app>"

MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Only read when EMAIL_PROVIDER=ses:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────
# Not used yet this phase (registration only, no login endpoint) — reserved
# so the login/JWT pass doesn't need a new env var.
JWT_SECRET=change-me-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Payments (MercadoPago) ──────────────────────────────────────────────
# Intentionally empty — PaymentsModule only has a NoopPaymentProvider today.
# Fill these in when wiring the real provider; no code change needed beyond
# swapping the provider implementation.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
